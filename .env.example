# ==============================================================================
# ToenToen Operations Web Environment Template (.env.example)
# Salin file ini menjadi .env.local untuk development lokal
# ==============================================================================

# ------------------------------------------------------------------------------
# SKENARIO 1: Penggantian Fase / Lingkungan Cepat (Rekomendasi Utama)
# ------------------------------------------------------------------------------
# Cukup tentukan stage yang diinginkan: dev | staging | prod | local
# - dev     -> https://dev-api-ops.toentoen.com/api/v1 (Pengembangan & QA)
# - staging -> https://staging-api-ops.toentoen.com/api/v1 (Pra-Produksi & UAT)
# - prod    -> https://api-ops.toentoen.com/api/v1 (Live Production)
# - local   -> http://localhost:8000/api/v1 (Backend Docker lokal)
APP_STAGE=dev

# ------------------------------------------------------------------------------
# SKENARIO 2: URL Backend Internal Kustom (Opsional - Mengabaikan APP_STAGE)
# ------------------------------------------------------------------------------
# Gunakan jika backend berjalan di IP/port khusus, tunnel ngrok, atau VPC private:
# INTERNAL_API_BASE_URL=https://dev-api-ops.toentoen.com/api/v1

# ------------------------------------------------------------------------------
# SKENARIO 3: Client Base URL (Standar Enterprise: /api/proxy)
# ------------------------------------------------------------------------------
# Tetap gunakan /api/proxy agar browser frontend tidak terkena CORS dan masalah sertifikat SSL:
NEXT_PUBLIC_API_BASE_URL=/api/proxy

# ------------------------------------------------------------------------------
# SKENARIO 4: Validasi Sertifikat SSL / TLS
# ------------------------------------------------------------------------------
# Di mode 'dev' atau 'local', verifikasi sertifikat diabaikan jika memakai wildcard mismatch.
# Di mode 'prod', verifikasi ketat otomatis menyala. Bisa di-override dengan:
# STRICT_TLS=true
